{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/CMake/${presetName}",
      "cacheVariables": {
        "ASTERIA_TARGET": "Host"
      }
    },
    {
      "name": "host-debug",
      "displayName": "Hosted tests with ASan and UBSan",
      "inherits": "host-base",
      "cacheVariables": {
        "ASTERIA_PROFILE": "Debug"
      }
    },
    {
      "name": "host-release",
      "displayName": "Optimized hosted tests with LTO",
      "inherits": "host-base",
      "cacheVariables": {
        "ASTERIA_PROFILE": "Release"
      }
    },
    {
      "name": "host-thread",
      "displayName": "Hosted tests with ThreadSanitizer",
      "inherits": "host-base",
      "cacheVariables": {
        "ASTERIA_PROFILE": "Thread"
      }
    },
    {
      "name": "host-analyze",
      "displayName": "GCC static analysis of every source, tool, and test",
      "inherits": "host-base",
      "cacheVariables": {
        "ASTERIA_PROFILE": "Analyze"
      }
    },
    {
      "name": "host-coverage",
      "displayName": "Hosted tests with Clang source-based coverage",
      "inherits": "host-base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "ASTERIA_PROFILE": "Coverage"
      }
    },
    {
      "name": "host-fuzz",
      "displayName": "Clang libFuzzer harnesses with ASan and UBSan",
      "inherits": "host-base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "ASTERIA_PROFILE": "Fuzz"
      }
    },
    {
      "name": "target-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/CMake/${presetName}"
    },
    {
      "name": "ia64",
      "displayName": "IA-64 UEFI firmware and ESP user images",
      "inherits": "target-base",
      "toolchainFile": "${sourceDir}/Tools/CMake/Toolchains/Ia64.cmake",
      "cacheVariables": {
        "ASTERIA_TARGET": "Ia64"
      }
    },
    {
      "name": "ia64-relocated",
      "displayName": "IA-64 firmware linked at a 4 GiB image base",
      "inherits": "target-base",
      "toolchainFile": "${sourceDir}/Tools/CMake/Toolchains/Ia64.cmake",
      "cacheVariables": {
        "ASTERIA_TARGET": "Ia64",
        "ASTERIA_FIRMWARE_IMAGE_BASE": "0x0000000100000000",
        "ASTERIA_COMPILE_CHECKS": "OFF"
      }
    },
    {
      "name": "ia64-synthetic-probe",
      "displayName": "IA-64 firmware with the synthetic user-probe diagnostic",
      "inherits": "target-base",
      "toolchainFile": "${sourceDir}/Tools/CMake/Toolchains/Ia64.cmake",
      "cacheVariables": {
        "ASTERIA_TARGET": "Ia64",
        "ASTERIA_IA64_SYNTHETIC_USER_PROBE": "1",
        "ASTERIA_COMPILE_CHECKS": "OFF"
      }
    },
    {
      "name": "ia64-preemption-probe",
      "displayName": "IA-64 firmware with the one-shot BSP preemption diagnostic (requires the synthetic user probe)",
      "inherits": "target-base",
      "toolchainFile": "${sourceDir}/Tools/CMake/Toolchains/Ia64.cmake",
      "cacheVariables": {
        "ASTERIA_TARGET": "Ia64",
        "ASTERIA_IA64_NATIVE_PREEMPTION_PROBE": "1",
        "ASTERIA_IA64_SYNTHETIC_USER_PROBE": "1",
        "ASTERIA_COMPILE_CHECKS": "OFF"
      }
    },
    {
      "name": "amd64",
      "displayName": "AMD64 UEFI firmware and ESP user images",
      "inherits": "target-base",
      "toolchainFile": "${sourceDir}/Tools/CMake/Toolchains/Amd64.cmake",
      "cacheVariables": {
        "ASTERIA_TARGET": "Amd64"
      }
    },
    {
      "name": "amd64-relocated",
      "displayName": "AMD64 firmware linked at a 4 GiB image base",
      "inherits": "target-base",
      "toolchainFile": "${sourceDir}/Tools/CMake/Toolchains/Amd64.cmake",
      "cacheVariables": {
        "ASTERIA_TARGET": "Amd64",
        "ASTERIA_FIRMWARE_IMAGE_BASE": "0x0000000100000000",
        "ASTERIA_COMPILE_CHECKS": "OFF"
      }
    },
    {
      "name": "amd64-preemption-probe",
      "displayName": "AMD64 firmware with the BSP preemption diagnostic",
      "inherits": "target-base",
      "toolchainFile": "${sourceDir}/Tools/CMake/Toolchains/Amd64.cmake",
      "cacheVariables": {
        "ASTERIA_TARGET": "Amd64",
        "ASTERIA_AMD64_NATIVE_PREEMPTION_PROBE": "1",
        "ASTERIA_COMPILE_CHECKS": "OFF"
      }
    },
    {
      "name": "amd64-preemption-probe-relocated",
      "displayName": "AMD64 firmware with the preemption diagnostic, linked at a 4 GiB image base",
      "inherits": "target-base",
      "toolchainFile": "${sourceDir}/Tools/CMake/Toolchains/Amd64.cmake",
      "cacheVariables": {
        "ASTERIA_TARGET": "Amd64",
        "ASTERIA_AMD64_NATIVE_PREEMPTION_PROBE": "1",
        "ASTERIA_COMPILE_CHECKS": "OFF",
        "ASTERIA_FIRMWARE_IMAGE_BASE": "0x0000000100000000"
      }
    },
    {
      "name": "amd64-stop-probe",
      "inherits": "amd64",
      "cacheVariables": {
        "ASTERIA_AMD64_STOP_PROBE": "1"
      }
    },
    {
      "name": "amd64-stop-early-probe",
      "inherits": "amd64-stop-probe",
      "cacheVariables": {
        "ASTERIA_AMD64_STOP_PROBE": "2"
      }
    },
    {
      "name": "amd64-x2apic-probe",
      "inherits": "amd64",
      "cacheVariables": {
        "ASTERIA_AMD64_X2APIC_HANDOFF_PROBE": "ON",
        "ASTERIA_COMPILE_CHECKS": "OFF"
      }
    },
    {
      "name": "ia64-stop-probe",
      "inherits": "ia64",
      "cacheVariables": {
        "ASTERIA_IA64_STOP_PROBE": "1",
        "ASTERIA_COMPILE_CHECKS": "OFF"
      }
    },
    {
      "name": "ia64-stop-early-probe",
      "inherits": "ia64",
      "cacheVariables": {
        "ASTERIA_IA64_STOP_PROBE": "2",
        "ASTERIA_COMPILE_CHECKS": "OFF"
      }
    },
    {
      "name": "amd64-watchdog-probe",
      "inherits": "amd64",
      "cacheVariables": {
        "ASTERIA_AMD64_STOP_PROBE": "3"
      }
    },
    {
      "name": "ia64-watchdog-probe",
      "inherits": "ia64",
      "cacheVariables": {
        "ASTERIA_IA64_STOP_PROBE": "3"
      }
    },
    {
      "name": "amd64-component-watchdog-probe",
      "inherits": "amd64",
      "cacheVariables": {
        "ASTERIA_COMPONENT_WATCHDOG_PROBE": "ON"
      }
    }
  ],
